/* ========================================
   STUDENT DASHBOARD STYLES
   Modern glassmorphism dashboard design
   with 3D WebGL elements
   ======================================== */

/* Dashboard Loading State */
.dashboard-loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  background: var(--bg-dark);
  color: #e0f7fa;
  font-weight: 500;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
}

/* Dashboard Container */
.dashboard-container {
  min-height: 100vh;
  position: relative;
  padding-top: 80px;
}

/* 3D Background Container */
.dashboard-3d-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0.6;
}

.dashboard-3d-background canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
}

/* Background Effects */
.dashboard-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  background: linear-gradient(135deg, var(--bg-dark) 0%, #0a1628 50%, var(--bg-darker) 100%);
  overflow: hidden;
}

.dashboard-bg .bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.3;
  animation: float 10s ease-in-out infinite;
}

.dashboard-bg .orb-1 {
  width: 600px;
  height: 600px;
  background: var(--primary);
  top: -200px;
  right: -200px;
}

.dashboard-bg .orb-2 {
  width: 400px;
  height: 400px;
  background: var(--secondary);
  bottom: -100px;
  left: -100px;
  animation-delay: -5s;
}

.dashboard-bg .grid-overlay {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(77, 208, 225, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(77, 208, 225, 0.02) 1px, transparent 1px);
  background-size: 60px 60px;
}

/* Dashboard Content */
.dashboard-content {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
}

/* Dashboard Navigation Bar */
.dashboard-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  font-weight: 700;
  font-size: 1.25rem;
  color: #ffffff;
  transition: all 0.3s ease;
}

.nav-logo:hover {
  color: #4dd0e1;
}

.nav-logo .logo-icon {
  font-size: 1.5rem;
}

.nav-logo .logo-text {
  background: linear-gradient(135deg, #4dd0e1 0%, #7c4dff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Welcome Section */
.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  margin-bottom: 2rem;
  padding: 2.5rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-xl);
  animation: fadeInUp 0.6s ease-out;
  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5);
}

.welcome-text h1 {
  font-size: clamp(2rem, 3vw, 2.5rem);
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 0.5rem 0;
  text-shadow: 0 3px 15px rgba(0, 0, 0, 0.6);
  letter-spacing: -0.02em;
}

.welcome-text p {
  font-size: clamp(1rem, 1.2vw, 1.15rem);
  color: #e0f7fa;
  margin: 0;
  font-weight: 500;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
}

.quick-actions {
  display: flex;
  gap: 1rem;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: var(--radius-lg);
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s ease;
  font-family: inherit;
}

.action-btn svg {
  width: 18px;
  height: 18px;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--bg-dark);
}

.action-btn.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(77, 208, 225, 0.3);
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  color: var(--text-primary);
}

.action-btn.secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.3);
}

/* Stats Section */
.stats-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.75rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-xl);
  animation: fadeInUp 0.6s ease-out backwards;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.stat-card:nth-child(1) { animation-delay: 0.1s; }
.stat-card:nth-child(2) { animation-delay: 0.2s; }
.stat-card:nth-child(3) { animation-delay: 0.3s; }
.stat-card:nth-child(4) { animation-delay: 0.4s; }

.stat-icon {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon svg {
  width: 28px;
  height: 28px;
}

.stat-icon.jobs {
  background: rgba(77, 208, 225, 0.15);
  color: var(--primary);
}

.stat-icon.applied {
  background: rgba(124, 77, 255, 0.15);
  color: var(--secondary);
}

.stat-icon.pending {
  background: rgba(255, 193, 7, 0.15);
  color: var(--warning);
}

.stat-icon.accepted {
  background: rgba(76, 175, 80, 0.15);
  color: var(--success);
}

.stat-info h3 {
  font-size: clamp(1.75rem, 2.5vw, 2rem);
  font-weight: 800;
  color: #ffffff;
  margin: 0;
  line-height: 1.2;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
}

.stat-info p {
  font-size: clamp(0.9rem, 1vw, 1rem);
  color: #b2ebf2;
  margin: 0;
  font-weight: 500;
  text-shadow: 0 1px 5px rgba(0, 0, 0, 0.4);
}

/* Dashboard Grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-bottom: 2rem;
}

/* Section Title */
.section-title {
  font-size: clamp(1.35rem, 1.6vw, 1.5rem);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 1.25rem 0;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  letter-spacing: -0.01em;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.see-all {
  font-size: 0.9rem;
  color: var(--primary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.see-all:hover {
  color: var(--primary-light);
}

/* Action Cards */
.action-cards {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  animation: fadeInUp 0.6s ease-out 0.5s backwards;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.cards-grid {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.dash-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.25rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all 0.3s ease;
  position: relative;
}

.dash-card:hover {
  background: rgba(77, 208, 225, 0.05);
  border-color: rgba(77, 208, 225, 0.3);
  transform: translateX(5px);
}

.card-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: rgba(77, 208, 225, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.card-icon svg {
  width: 24px;
  height: 24px;
  color: var(--primary);
}

.card-icon.ai {
  background: linear-gradient(135deg, rgba(124, 77, 255, 0.2), rgba(77, 208, 225, 0.2));
}

.card-icon.ai svg {
  color: var(--secondary);
}

.dash-card:hover .card-icon {
  transform: scale(1.1);
}

.dash-card h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 0.25rem 0;
}

.dash-card p {
  font-size: 0.9rem;
  color: #b2ebf2;
  margin: 0;
  flex: 1;
  font-weight: 500;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}

.card-arrow {
  font-size: 1.25rem;
  color: #b2ebf2;
  transition: all 0.3s ease;
}

.dash-card:hover .card-arrow {
  color: var(--primary);
  transform: translateX(5px);
}

.dash-card.highlight {
  background: linear-gradient(135deg, rgba(124, 77, 255, 0.1), rgba(77, 208, 225, 0.1));
  border-color: rgba(124, 77, 255, 0.3);
  cursor: default;
}

.ai-badge {
  padding: 0.3rem 0.85rem;
  background: linear-gradient(135deg, var(--secondary), var(--primary));
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 700;
  color: white;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

/* Recent Jobs */
.recent-jobs {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  animation: fadeInUp 0.6s ease-out 0.6s backwards;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.jobs-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.job-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.125rem 1.5rem;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

.job-item:hover {
  background: rgba(77, 208, 225, 0.05);
  border-color: rgba(77, 208, 225, 0.3);
  transform: translateX(5px);
}

.job-info h4 {
  font-size: clamp(1rem, 1.15vw, 1.1rem);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 0.25rem 0;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
}

.job-company {
  font-size: clamp(0.925rem, 1.05vw, 1rem);
  color: #e0f7fa;
  margin: 0 0 0.5rem 0;
  font-weight: 500;
  text-shadow: 0 1px 5px rgba(0, 0, 0, 0.4);
}

.job-meta {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.job-location {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: clamp(0.875rem, 0.95vw, 0.925rem);
  color: #b2ebf2;
  font-weight: 500;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}

.job-type {
  padding: 0.25rem 0.625rem;
  background: rgba(77, 208, 225, 0.15);
  border-radius: var(--radius-sm);
  font-size: clamp(0.8rem, 0.9vw, 0.875rem);
  color: var(--primary);
  font-weight: 600;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

.job-salary {
  font-size: clamp(0.975rem, 1.1vw, 1.05rem);
  font-weight: 700;
  color: var(--success);
  white-space: nowrap;
  text-shadow: 0 2px 8px rgba(0, 230, 118, 0.4);
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem;
  text-align: center;
  color: #b2ebf2;
}

.empty-state svg {
  width: 48px;
  height: 48px;
  margin-bottom: 1rem;
  opacity: 0.7;
}

.empty-state p {
  margin: 0;
  font-size: clamp(1rem, 1.15vw, 1.1rem);
  font-weight: 500;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
}

/* Skills Section */
.skills-section {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  animation: fadeInUp 0.6s ease-out 0.7s backwards;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.skill-tag {
  padding: 0.5rem 1.125rem;
  background: rgba(77, 208, 225, 0.15);
  border: 1px solid rgba(77, 208, 225, 0.25);
  border-radius: var(--radius-full);
  font-size: clamp(0.925rem, 1.05vw, 1rem);
  color: var(--primary);
  font-weight: 600;
  transition: all 0.3s ease;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}

.skill-tag:hover {
  background: rgba(77, 208, 225, 0.2);
  transform: translateY(-2px);
}

/* Resume Section */
.resume-section {
  animation: fadeInUp 0.6s ease-out 0.8s backwards;
  margin-top: 1.5rem;
}

/* ========================================
   RESPONSIVE DESIGN
   ======================================== */

@media (max-width: 1200px) {
  .stats-section {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .dashboard-content {
    padding: 1.5rem;
  }
  
  .welcome-section {
    flex-direction: column;
    text-align: center;
  }
  
  .quick-actions {
    width: 100%;
    justify-content: center;
  }
  
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .dashboard-content {
    padding: 1rem;
  }
  
  .welcome-section {
    padding: 1.5rem;
  }
  
  .welcome-text h1 {
    font-size: 1.5rem;
  }
  
  .stats-section {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .stat-card {
    padding: 1.25rem;
  }
  
  .stat-icon {
    width: 48px;
    height: 48px;
  }
  
  .stat-icon svg {
    width: 24px;
    height: 24px;
  }
  
  .stat-info h3 {
    font-size: 1.5rem;
  }
  
  .quick-actions {
    flex-direction: column;
  }
  
  .action-btn {
    width: 100%;
    justify-content: center;
  }
  
  .job-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  
  .job-salary {
    align-self: flex-end;
  }
}

/* ========================================
   ANIMATIONS
   ======================================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20px) scale(1.02);
  }
}
